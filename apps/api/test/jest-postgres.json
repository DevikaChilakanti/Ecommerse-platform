{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "cart\\.postgres\\.integration\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/postgres-test-setup.ts"]
}
